# OpenRouter credentials and model selection.
# Copy this to .env (which is gitignored) and fill in your key:
#   cp .env.example .env
# Get a key:      https://openrouter.ai/keys
# Browse models:  https://openrouter.ai/models   (use the slug exactly as listed; model names go stale, so check there)

OPENROUTER_API_KEY=

# The model to call. Any OpenRouter slug works; override per-call with --model.
# Placeholder default: replace it with a current slug from the models page.
OPENROUTER_MODEL=openai/gpt-4o-mini

# Optional. Seconds-long model calls are normal; the default deadline is 300000 ms. Raise it for slow models.
# OPENROUTER_TIMEOUT_MS=300000

# Optional. Only change the base URL for a proxy/self-host.
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Optional attribution headers (used for OpenRouter app rankings).
# Leave OPENROUTER_APP_URL unset: this project is local-only and has no public URL.
# OPENROUTER_APP_NAME=Exemplary Examples
