# OpenRouter credentials and model selection.
# Copy this to .env (which is gitignored) and fill in your key:
#   cp .env.example .env
# Get a key:      https://openrouter.ai/keys
# Approval: operations/AI-DATA-POLICY.md (one paid model, owner-only Claim Audit and Illustrative Examples).

OPENROUTER_API_KEY=

# The only registered model. Other slugs and :free variants are refused by default.
# General brand/engineering cards use synthetic or deliberately public inputs only.
OPENROUTER_MODEL=tencent/hy3

# Optional. Seconds-long model calls are normal; the default deadline is 300000 ms. Raise it for slow models.
# OPENROUTER_TIMEOUT_MS=300000

# Optional transport override for an explicitly authorized proxy or offline test.
# Changing an endpoint does not approve a new provider, account, model, or data purpose.
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Optional attribution headers (used for OpenRouter app rankings).
# Leave OPENROUTER_APP_URL unset: this project is local-only and has no public URL.
# OPENROUTER_APP_NAME=Exemplary Examples
